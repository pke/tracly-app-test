{
  "name": "docs",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "markdown-to-jsx": "7.7.17",
    "serialize-javascript": "7.1.0",
    "uuid": "11.1.1",
    "vue-template-compiler": "npm:@vue/compiler-sfc@3.5.41",
    "webpack-dev-server": "5.2.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "babel-loader": "9.2.1",
    "core-js": "3.50.0",
    "css-loader": "7.1.4",
    "documentation": "14.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-styleguidist": "13.1.4",
    "webpack": "5.109.2"
  },
  "scripts": {
    "build:hooks": "documentation build --document-exported ../src/hooks/*.js -f md -o ./hooks.md",
    "build": "npm run build:hooks && cd .. && styleguidist build --config docs/styleguide.config.js",
    "dev": "npm run build:hooks -- --watch & styleguidist server"
  }
}
