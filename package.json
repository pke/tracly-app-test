{
  "name": "tracly-app-test",
  "version": "1.4.0",
  "private": true,
  "description": "tracly app test",
  "license": "MIT",
  "repository": "tracly/tracly-app-test",
  "homepage": "https://tracly-app-test.now.sh/",
  "engines": {
    "node": "24.x"
  },
  "browserslist": [
    "> 0.5%",
    "not dead"
  ],
  "overrides": {
    "ini": "1.3.8"
  },
  "scripts": {
    "postinstall": "npm ci --prefix docs",
    "dev": "parcel src/index.html",
    "dev:docs": "cd docs && npm run dev",
    "build:docs": "cd docs && npm run build",
    "prebuild": "npm run build:docs",
    "build": "parcel build src/index.html --dist-dir public --no-cache",
    "test": "c8 mocha \"tests/*.test.js\"",
    "testw": "npm t -- --watch",
    "lint:js": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "author": {
    "name": "Philipp Kursawe",
    "email": "phil.kursawe+tracly@gmail.com",
    "url": "https://pke.fyi/"
  },
  "dependencies": {
    "assert": "2.1.0",
    "leaflet": "1.9.4",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@babel/preset-react": "7.29.7",
    "@eslint/js": "9.39.5",
    "c8": "12.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-mocha": "11.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "mocha": "11.8.0",
    "parcel": "2.16.4",
    "posthtml-expressions": "1.11.4",
    "process": "0.11.10",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0"
  }
}
